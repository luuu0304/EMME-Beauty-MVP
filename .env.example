# Copiá este archivo a .env en la raíz del proyecto:
#   cp .env.example .env
#
# Si ya tenías un contenedor Docker con la password vieja del index.js, usá:
#   cp .env.lu.example .env

# --- Backend ---
PORT=3000

# --- SQL Server (Docker + backend) ---
DB_USER=sa
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=EmmE_Beauty
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_USE_UTC=false

# DB_PASSWORD — tiene que coincidir con la password de TU contenedor Docker.
#
# Opción A — Lu / contenedor existente (la que estaba en index.js):
#   DB_PASSWORD=TThmA4bmPfPUk*
#
# Opción B — setup nuevo con docker compose del repo:
#   DB_PASSWORD=EmmeBeauty_Dev2026!

DB_PASSWORD=EmmeBeauty_Dev2026!
